{
  "name": "kapruka-messenger-bot",
  "version": "1.0.0",
  "private": true,
  "description": "AI agent that replies to Facebook Messenger (and later WhatsApp) messages using OpenAI, with per-ad product context and logging from Google Sheets.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dashboard": "node dashboard/server.js",
    "drive-auth": "node scripts/driveAuth.js",
    "postinstall": "npx puppeteer browsers install chrome"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^140.0.1",
    "openai": "^4.68.0",
    "puppeteer": "^23.6.0"
  }
}
